{
  "name": "caisse-eglise",
  "version": "1.0.0",
  "description": "Gestion de caisse d'une église - application desktop",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "mg.eglise.caisse",
    "productName": "Gestion de Caisse d'une Église",
    "files": ["dist/**", "electron/**"],
    "extraResources": [{ "from": "../backend", "to": "backend", "filter": ["**/*", "!**/__pycache__", "!.env", "!*.db"] }],
    "win": { "target": "nsis" }
  }
}

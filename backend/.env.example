# Copiez ce fichier en ".env" puis remplacez par votre chaîne de connexion Supabase.
# Supabase > Project Settings > Database > Connection string > URI
# Utilisez le "Session pooler" (port 5432) ou la connexion directe.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Seuil minimal du solde (Ar) : le solde ne doit jamais descendre en dessous
SEUIL_MINIMAL=10000

# Compte administrateur créé au premier lancement (changez le mot de passe ensuite)
ADMIN_USERNAME=admin
ADMIN_MATRICULE=ADM001
ADMIN_PASSWORD=admin123
# Clé de signature des sessions (optionnel : sinon un fichier .secret est généré)
# SECRET_KEY=une-longue-valeur-aleatoire
